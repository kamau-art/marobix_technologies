# Public site URL (used for sitemap, OG, payment return URLs)
NEXT_PUBLIC_SITE_URL=https://marobix.com

# --- Sanity CMS (content, leads, orders) ---
# Optional: without these the site runs on bundled seed content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Write token (needed for lead/order capture + Studio content edits)
SANITY_API_TOKEN=

# --- M-Pesa (Safaricom Daraja) — NOT YET IMPLEMENTED ---
# Deferred to a later release. When wiring up M-Pesa, add these and
# re-enable the M-Pesa option in src/components/CheckoutForm.js.
# MPESA_ENV: sandbox or production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Publicly reachable HTTPS callback URL for STK push results
MPESA_CALLBACK_URL=

# --- Stripe (card payments) ---
# Secret key: sk_test_... / sk_live_...
STRIPE_SECRET_KEY=

# --- PayPal ---
# PAYPAL_ENV: sandbox or production
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
